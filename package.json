{
  "name": "cs-game-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "postinstall": "npm run build --workspace=shared",
    "dev": "npm run build --workspace=shared && concurrently -n client,server -c blue,green \"npm run dev --workspace=client\" \"npm run dev --workspace=server\"",
    "build": "npm run build --workspace=shared && npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "concurrently": "^10.0.4",
    "jsdom": "^30.0.1",
    "vitest": "^4.1.10"
  }
}

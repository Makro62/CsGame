{
  "name": "cs-game-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "client"
  ],
  "scripts": {
    "postinstall": "npm run build --workspace=shared",
    "dev": "npm run build --workspace=shared && npm run dev --workspace=client",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript-eslint": "^8.67.0"
  }
}
